<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for the pan inbox watcher (the independent, event-driven
  process that nudges the orchestrator when a new inbox item lands). It runs as a
  second agent so it is supervised independently of any Claude session's own loop.
  This file carries NO secrets — the watcher only wakes the orchestrator's hc terminal.

  Installed by `pan service install`, which fills in the PAN_HOME placeholder (your home
  directory) and the PAN_BIN placeholder (the installed `pan` executable). See README.md
  for a manual install.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pan.watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string><PAN_BIN></string>
        <string>watcher</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PAN_LOG_LEVEL</key>
        <string>INFO</string>
        <!-- launchd's default PATH lacks ~/.local/bin, where uv puts pan and the herdr-core
             installer puts hc; the watcher shells hc to wake the orchestrator. -->
        <key>PATH</key>
        <string><PAN_HOME>/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string><PAN_HOME>/.pan/logs/watcher.out.log</string>
    <key>StandardErrorPath</key>
    <string><PAN_HOME>/.pan/logs/watcher.err.log</string>
</dict>
</plist>
