<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for the pan Slack gateway (the always-on Bolt Socket Mode
  process). This file carries NO secrets — the Slack tokens live in
  <PAN_HOME>/.pan/credentials.json (mode 0600) and are read by the process itself.

  Installed by `pan service install`, which fills in the PAN_HOME placeholder (your home
  directory) and the PAN_BIN placeholder (the installed `pan` executable). See README.md
  for a manual install.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pan.gateway</string>

    <key>ProgramArguments</key>
    <array>
        <string><PAN_BIN></string>
        <string>gateway</string>
    </array>

    <!-- The one process that must always be up; Socket Mode reconnects after a
         network blip or wake. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PAN_LOG_LEVEL</key>
        <string>INFO</string>
        <!-- launchd's default PATH lacks ~/.local/bin, where uv puts pan and the herdr-core
             installer puts hc; the watcher shells hc to wake the orchestrator. -->
        <key>PATH</key>
        <string><PAN_HOME>/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string><PAN_HOME>/.pan/logs/gateway.out.log</string>
    <key>StandardErrorPath</key>
    <string><PAN_HOME>/.pan/logs/gateway.err.log</string>
</dict>
</plist>
